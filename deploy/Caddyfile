# Primary production domain. Serve ONLY dist via the release symlink.
balfest.ru {
    root * /var/www/balfest/current
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Cache-Control "public, max-age=0, must-revalidate"
    }

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=3600, must-revalidate"

    file_server
    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
}

# Uncomment only after DNS for each alias points to the same server.
# www.balfest.ru, xn--80abnx5agl.xn--p1ai {
#     redir https://balfest.ru{uri} permanent
# }
